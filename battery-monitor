#!/bin/bash

BAT="BAT1"
SOUND_WARN="/usr/share/sounds/freedesktop/stereo/dialog-warning.oga"

warn20=0
warn10=0
warn5=0
prev_status=""

while true; do
    capacity=$(cat /sys/class/power_supply/$BAT/capacity 2>/dev/null)
    status=$(cat /sys/class/power_supply/$BAT/status 2>/dev/null)

    if [ -z "$capacity" ] || [ -z "$status" ]; then
        sleep 60
        continue
    fi

    if [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
        if [ "$prev_status" != "$status" ]; then
            warn20=0
            warn10=0
            warn5=0
        fi
    fi

    if [ "$status" = "Discharging" ]; then
        if [ "$capacity" -le 20 ] && [ "$warn20" -eq 0 ]; then
            notify-send "Battery Warning" "Battery is at ${capacity}%"
            paplay "$SOUND_WARN" >/dev/null 2>&1 &
            warn20=1
        fi

        if [ "$capacity" -le 10 ] && [ "$warn10" -eq 0 ]; then
            notify-send "Battery Critical" "Battery is at ${capacity}%"
            paplay "$SOUND_WARN" >/dev/null 2>&1 &
            warn10=1
        fi

        if [ "$capacity" -le 5 ] && [ "$warn5" -eq 0 ]; then
            notify-send -u critical "Battery Very Low" "Plug in now! Battery is at ${capacity}%"
            paplay "$SOUND_WARN" >/dev/null 2>&1 &
            warn5=1
        fi
    fi

    prev_status="$status"
    sleep 60
done
