#!/bin/sh

vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
# output: "Volume: 0.75" or "Volume: 0.75 [MUTED]"

mute=$(echo "$vol" | grep -c "MUTED")
vol_num=$(echo "$vol" | awk '{printf "%d", $2 * 100}')

if [ "$mute" -gt 0 ]; then
    icon="󰝟"
elif [ "$vol_num" -ge 70 ]; then
    icon=" "
elif [ "$vol_num" -ge 30 ]; then
    icon=" "
else
    icon=" "
fi

printf "%s %d%%" "$icon" "$vol_num"
